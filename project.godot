; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited, but don't remove the config_version!

config_version=5

[application]

config/name="beacon"
config/description="Autonomous Cyber-Physical Fleet Orchestrator, Multi-Sensor Fusion Engine, and Kinodynamic Trajectory Verification Substrate in GDScript"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=50
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
